# Copy this file to `.env` and edit it. Any option you can pass to `wintermute` on the
# command line can also be set here as `key=value` (CLI flags override the .env file).
# See `wintermute <UseCase> --help` for the full set of options.

# --- LLM connection (single upstream: litellm) -------------------------------
# Your provider API key.
llm.api_key='your-api-key'

# Model name in litellm format. Examples:
#   openrouter/anthropic/claude-3.5-sonnet   (default endpoint is OpenRouter)
#   gpt-4o                                    (set llm.api_base for OpenAI)
#   ollama_chat/llama3                        (a local Ollama model)
llm.model='openrouter/anthropic/claude-3.5-sonnet'

# Maximum context size of the model (used for prompt trimming).
llm.context_size=16385

# Endpoint base URL. Defaults to OpenRouter; uncomment/point elsewhere as needed:
#llm.api_base='https://openrouter.ai/api'
# OpenRouter provider routing (leave empty unless you use OpenRouter):
#llm.provider=''
# Route requests through an intercepting proxy (e.g. Burp/mitmproxy):
#llm.proxy=''
#llm.proxy_insecure=False

# --- Target connection (SSH) -------------------------------------------------
# IP/host of your target VM.
conn.host='enter-the-private-ip-of-some-vm.local'
# Hostname the target reports (used for root/success detection).
conn.hostname='the-hostname-of-the-vm'
conn.port=22

# Credentials for the low-privilege user on the target VM.
conn.username='lowpriv'
# For key-only auth, set conn.password='' (empty, no space).
conn.password='trustno1'
# For password-only auth, leave this empty. Otherwise point it at your key file,
# e.g. '/home/lowpriv/.ssh/id_ed25519'.
conn.keyfilename=''

# --- Run limits --------------------------------------------------------------
# Cap a run by rounds, tokens, cost (USD) and/or wall-clock duration (0 = no limit).
limits.max_rounds=100
limits.max_cost=10.0
#limits.max_tokens=0
#limits.max_duration=0

# --- Optional: RAG for the PrivEscLinux use-case -----------------------------
# Install the extra first (`uv sync --extra rag`) and point `--rag_path` at a folder
# of markdown documents to enable retrieval-augmented generation:
#rag_path=''
